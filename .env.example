# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datapulse
DB_USER=datapulse_user
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Optional: one connection URL instead of the DB_* values above, e.g. Render's
# External Database URL when running setup or seed scripts from your machine.
# DATABASE_URL=

# Frontend (Vite build environment). Production builds without it call the API
# on the same origin, as in the single-service Render Blueprint.
VITE_API_URL=http://localhost:3000/api
